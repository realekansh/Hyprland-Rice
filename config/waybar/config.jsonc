{
    /* =========================================================
     * GLOBAL
     * ========================================================= */

    "layer": "top",
    "position": "top",
    "mode": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,


    /* =========================================================
     * INCLUDES
     * ========================================================= */

    "include": [
        "~/.config/waybar/modules/*.jsonc",
        "~/.config/waybar/modules/custom/*.jsonc",
        "~/.config/waybar/modules/extra/*.jsonc",
        "~/.config/waybar/modules/hyprland/*.jsonc"
    ],

    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,


    /* =========================================================
     * LEFT SIDE MODULES
     * App Launcher + Clock + Media Player
     * ========================================================= */

    "modules-left": [
        "custom/app",
        "clock",
        "custom/media"
    ],


    /* =========================================================
     * MIDDLE SIDE MODULES
     * Hyprland Workspaces
     * ========================================================= */

    "modules-center": [
        "hyprland/workspaces"
    ],


    /* =========================================================
     * RIGHT SIDE MODULES
     * Tray + Connectivity + System Controls + Notifications/Power
     * ========================================================= */

    "modules-right": [
		"group/status",
        "group/connectivity",
        "group/system",
        "group/notifications"
    ],


    /* =========================================================
     * GROUP DEFINITIONS
     * ========================================================= */

	 "group/status": {
    	"orientation": "horizontal",
    	"modules": [
        	"custom/updates"
    	]
	},
    /* ---------------------------------------------------------
     * Connectivity
     * Network + Bluetooth + VPN
     * --------------------------------------------------------- */

    "group/connectivity": {
        "orientation": "horizontal",
        "modules": [
            "network",
            "bluetooth",
            "custom/vpn"
        ]
    },


    /* ---------------------------------------------------------
     * System Controls
     * Backlight + Audio + Microphone + Battery
     * --------------------------------------------------------- */

    "group/system": {
        "orientation": "horizontal",
        "modules": [
            "backlight",
            "pulseaudio",
            "pulseaudio#microphone",
            "battery"
        ]
    },


    /* ---------------------------------------------------------
     * Notifications / Power
     * --------------------------------------------------------- */

    "group/notifications": {
        "orientation": "horizontal",
        "modules": [
            "custom/swaync",
            "custom/power_btn"
        ]
    },


    /* =========================================================
     * EXTRA GROUPS
     * ========================================================= */


    /* ---------------------------------------------------------
     * Audio
     * --------------------------------------------------------- */

    "group/audio": {
        "orientation": "horizontal",
        "modules": [
            "pulseaudio",
            "pulseaudio#microphone"
        ]
    },


    /* ---------------------------------------------------------
     * Exit
     * --------------------------------------------------------- */

    "group/exit": {
        "orientation": "horizontal",
        "modules": [
            "custom/power_btn"
        ]
    }
}