# Catppuccin Mocha theme for btop
# Matching Waybar & Hyprland Rice

# Main background, empty for terminal default (transparency support)
theme[main_bg]="#151227"

# Main text color
theme[main_fg]="#cdd6f4"

# Title text color
theme[title]="#cdd6f4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#89b4fa"

# Background color of selected item in processes box
theme[selected_bg]="#2f354a"

# Foreground color of selected item in processes box
theme[selected_fg]="#89b4fa"

# Color of inactive text
theme[inactive_fg]="#6c7086"

# Color of text appearing top on boxes
theme[graph_text]="#6c7086"

# Misc colors for processes box including mini version graph, progress bar background, etc.
theme[proc_misc]="#89b4fa"

# Cpu box outline color
theme[cpu_box]="#89b4fa"

# Memory box outline color
theme[mem_box]="#a6e3a1"

# Net box outline color
theme[net_box]="#cba6f7"

# Processes box outline color
theme[proc_box]="#89dceb"

# Box divider line and small symbols
theme[div_line]="#313244"

# Temperature graph colors (Green -> Yellow -> Red)
theme[temp_start]="#a6e3a1"
theme[temp_mid]="#f9e2af"
theme[temp_end]="#f38ba8"

# CPU graph colors (Blue -> Mauve -> Red)
theme[cpu_start]="#89b4fa"
theme[cpu_mid]="#cba6f7"
theme[cpu_end]="#f38ba8"

# Mem/Disk free meter (Green -> Cyan -> Blue)
theme[free_start]="#a6e3a1"
theme[free_mid]="#89dceb"
theme[free_end]="#89b4fa"

# Mem/Disk cached meter (Cyan -> Blue -> Mauve)
theme[cached_start]="#89dceb"
theme[cached_mid]="#89b4fa"
theme[cached_end]="#cba6f7"

# Mem/Disk available meter (Green -> Yellow -> Peach)
theme[available_start]="#a6e3a1"
theme[available_mid]="#f9e2af"
theme[available_end]="#fab387"

# Mem/Disk used meter (Blue -> Mauve -> Red)
theme[used_start]="#89b4fa"
theme[used_mid]="#cba6f7"
theme[used_end]="#f38ba8"

# Download graph colors (Green -> Cyan -> Blue)
theme[download_start]="#a6e3a1"
theme[download_mid]="#89dceb"
theme[download_end]="#89b4fa"

# Upload graph colors (Peach -> Red -> Mauve)
theme[upload_start]="#fab387"
theme[upload_mid]="#f38ba8"
theme[upload_end]="#cba6f7"

# Process box color gradient for Cpu status (Green -> Yellow -> Red)
theme[process_start]="#a6e3a1"
theme[process_mid]="#f9e2af"
theme[process_end]="#f38ba8"

# Process details, follow and banner status colors
theme[followed_fg]="#89b4fa"
theme[followed_bg]="#2f354a"
theme[proc_follow_bg]="#2f354a"
theme[proc_pause_bg]="#2f354a"
theme[proc_banner_fg]="#1e1e2e"
theme[proc_banner_bg]="#89b4fa"
